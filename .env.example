# Copy to .env.local for local development (next dev auto-loads .env.local).
# In production, set these via AWS Systems Manager Parameter Store or AWS Secrets Manager and
# inject them into the EC2/Docker Compose environment at deploy time — see
# docs/DEPLOYMENT.md. Never commit real secrets to this repo.

# --- Database: PostgreSQL on Amazon RDS (production) or Docker Postgres (development). ---
DATABASE_URL=postgres://eladl:eladl_dev_pw@localhost:55433/eladl
# DATABASE_SSL=true enables TLS to the database; set it for RDS, leave unset for local Docker.
DATABASE_SSL=false
# DATABASE_SSL_CA_PATH: path to Amazon RDS's combined CA bundle (recommended for production
# instead of the insecure rejectUnauthorized:false fallback). Download from:
# https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# DATABASE_SSL_CA_PATH=/etc/eladl/rds-ca-bundle.pem

# --- Signs the membership applicant-access cookie (separate, narrow mechanism from staff
# auth). Generate with `openssl rand -hex 32`. ---
SESSION_SECRET=replace-with-a-long-random-session-secret

# --- Base URL used to build magic-link / applicant-access verification links in outgoing email. ---
PUBLIC_BASE_URL=http://localhost:3000

# --- Auth.js v5 (staff identity/session source of truth). ---
# AUTH_SECRET: generate with `npx auth secret` or `openssl rand -hex 32`.
AUTH_SECRET=replace-with-a-long-random-auth-secret
AUTH_URL=http://localhost:3000

# --- AWS S3 object storage (media uploads). ---
AWS_REGION=us-east-1
# On EC2, prefer attaching an IAM instance role scoped to this bucket instead of static keys —
# leave AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY unset in that case; the SDK's default
# credential provider chain resolves instance-role credentials automatically.
# AWS_ACCESS_KEY_ID=replace-with-an-iam-user-access-key-id
# AWS_SECRET_ACCESS_KEY=replace-with-an-iam-user-secret-access-key
AWS_S3_BUCKET_NAME=eladl-media
# AWS_S3_ENDPOINT: only set for local development against the MinIO container; leave unset in
# production to use real AWS S3.
AWS_S3_ENDPOINT=http://localhost:59000
# AWS_S3_PUBLIC_BASE_URL: a CloudFront distribution domain or the bucket's public endpoint, if
# media should be served directly rather than proxied through the app. Leave unset to fall
# back to an app-served /media/:objectKey route (not yet implemented — see docs/SECURITY.md).
# AWS_S3_PUBLIC_BASE_URL=https://media.eladl.party

# --- Redis: Docker Redis locally, Amazon ElastiCache (or self-managed Redis) in production.
# Used for rate limiting and as the BullMQ job queue backend. ---
REDIS_URL=redis://localhost:6390

# --- Optional: transactional email provider. Omit to keep the safe logging no-op adapter
# (magic links/notifications are logged to the console instead of sent). ---
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=replace-with-a-real-resend-api-key
# EMAIL_FROM=notifications@example.com

# --- Optional: Cloudflare Turnstile secret for public form bot protection. Not yet
# verified by any route until a site/secret key pair is provisioned (see docs/SECURITY.md). ---
# TURNSTILE_SECRET_KEY=replace-with-a-turnstile-secret-key

# --- Optional: AI provider key for richer assistant answers. The assistant works correctly
# without this (keyword retrieval over approved knowledge only); see docs/SECURITY.md. ---
# AI_PROVIDER_API_KEY=replace-with-an-ai-provider-api-key
